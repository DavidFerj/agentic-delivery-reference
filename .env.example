# Safe local defaults. Copy to .env and keep that file untracked.
ADR_ENVIRONMENT=local
ADR_LOG_LEVEL=INFO
API_PORT=8080
WORKER_PORT=8081
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_TELEMETRY_DISABLED=1
ADR_AUTH_MODE=local
ADR_WEB_ORIGIN=http://localhost:3000
ADR_GOVERNANCE_MODE=enforce
ADR_RATE_LIMIT_REQUESTS=100
ADR_RATE_LIMIT_WINDOW_SECONDS=60

# Documented local bearer values are fixtures, not secrets. External integrations remain disabled.
ADR_MODEL_PROVIDER=simulated
ADR_N8N_ENABLED=false
ADR_VAPI_ENABLED=false
ADR_MCP_ENABLED=false
